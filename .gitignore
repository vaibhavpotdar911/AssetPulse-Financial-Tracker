# =================================================================
# AssetPulse - Git Ignore Rules
# =================================================================

# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Next.js Build Outputs
/.next/
/out/
/build
/dist

# SQLite Local Database Files & Journals
*.db
*.db-journal
*.db-wal
*.db-shm
/prisma/*.db
/prisma/*.db-journal
/prisma/*.db-wal
/prisma/*.db-shm
fintrack.db*

# Environment Variables & Secrets
.env
.env*.local
!.env.example

# Testing & Coverage Artifacts
/coverage
*.lcov
/.vitest

# Debug & Error Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Configurations
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# TypeScript Cache
*.tsbuildinfo
next-env.d.ts

# Agent Metadata & Internal Transcripts (Workspace convention)
.agents/
