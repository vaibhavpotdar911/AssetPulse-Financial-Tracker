# ==============================================================================
# AssetPulse Environment Configuration
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000

# Dual-Database Engine Configuration
# Supported DB_TYPE values: 'sqlite' (default zero-config embedded) or 'mysql'
DB_TYPE=sqlite
DATABASE_URL="file:./fintrack.db"

# Example External MySQL Connection:
# DB_TYPE=mysql
# DATABASE_URL="mysql://root:password@localhost:3306/assetpulse"

# JWT Authentication & Session Token
# In production, generate a secure 256-bit secret (e.g. `openssl rand -hex 32`)
JWT_SECRET="assetpulse-super-secret-development-jwt-key-32chars"
NEXTAUTH_SECRET="assetpulse-super-secret-development-jwt-key-32chars"
SESSION_MAX_AGE_SECONDS=604800

# Proactive Notifications & Outbound Webhooks (Optional)
# Supported types: discord, slack, telegram, generic
WEBHOOK_TYPE=generic
WEBHOOK_URL=""
WEBHOOK_TIMEOUT_MS=5000

# Scheduled Maturity Cron Protection (Optional)
CRON_SECRET="assetpulse-cron-secret-token"
